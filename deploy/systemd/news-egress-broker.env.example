# Environment file template for ``news-egress-broker@<route>.service``.
#
# Copy this file to:
#   ~/.config/systemd/user/news-egress-broker@<route>.env
# and edit the placeholders.  The systemd unit template picks the
# matching file at start-up.
#
# SECURITY: do NOT put real chat IDs, bearer tokens, or remote
# endpoints in this file.  Real values belong in the policy file
# referenced by ``NEWS_EGRESS_POLICY_PATH``.

# Immutable installed release root containing host/news_egress_broker.py.
NEWS_EGRESS_CODE_ROOT=/opt/news-pipeline/current

# Route-specific TOML policy. Copy this template once per route.
NEWS_EGRESS_POLICY_PATH=/etc/news-pipeline/search-broker.toml